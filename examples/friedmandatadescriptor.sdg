DATASET FriedmanDataGenerator;
DESC "Stream generator introduced by Friedman\n\n Relevant paper:\n Friedman, Jerome H. Multivariate Adaptive Regression Splines. The Annals of Statistics 19.1 (1991): 1-141.\n Available online: http://www.stat.yale.edu/~lc436/08Spring665/Mars_Friedman_91.pdf";
PARAM seed:int, "The seed of the random generator", 42;
FEATURE x1:float, "The first variable" WITH UniformFloat(0, 1);
FEATURE x2:float, "The second variable" WITH UniformFloat(0, 1);
FEATURE x3:float, "The third variable" WITH UniformFloat(0, 1);
FEATURE x4:float, "The fourth variable" WITH UniformFloat(0, 1);
FEATURE x5:float, "The fifth variable" WITH UniformFloat(0, 1);
FEATURE x6:float, "The sixth variable" WITH UniformFloat(0, 1);
FEATURE x7:float, "The seventh variable" WITH UniformFloat(0, 1);
FEATURE x8:float, "The eighth variable" WITH UniformFloat(0, 1);
FEATURE x9:float, "The ninth variable" WITH UniformFloat(0, 1);
FEATURE x10:float, "The tenth variable" WITH UniformFloat(0, 1);
FEATURE noise:float, "Noise of the target" WITH Gaussian(0, 1);
TARGET y:scalar, "The target variable defined as a function of the features" WITH 10 * math.sin(math.pi * x1 * x2) + 20 * (x3 - 0.5) ** 2 + 10 * x4 + 5 * x5 + noise;
