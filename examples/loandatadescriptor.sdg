dataset LoanDatasetStreamGenerator
    description: "A stream generator for loans, introduced in publication:\n Kalaitzidis, E., Diamantopoulos, T., Michailoudis, A., Symeonidis, A. L. (2025).\n AML4S: An AutoML Pipeline for Data Streams. Machine Learning and Knowledge Extraction 7.3, 87.\n This generator is based on the generator introduced by Agrawal et al.\n (Agrawal, R., Ghosh, S., Imielinski, T., Iyer, B., & Swami, A. N. (1992).\n An interval classifier for database mining applications. In VLDB (Vol. 92, pp. 560-573).\n Available: https://agrawal-family.com/rakesh/papers/vldb92ic.pdf.)"
    parameters
        seed: "The seed of the random generator"
    end
    features
        float salary: UniformFloat(20000, 60000), "Salary"
        float commission: UniformFloat(0, 0.1 * salary), "Commission"
        int age: UniformInteger(20, 80), "Age"
        int educationlevel: UniformInteger(0, 4), "Education Level"
        int zipcode: UniformInteger(0, 8), "Zip Code of the Town"
        float housevalue: UniformFloat(100000 * (8 - zipcode + 1), 2 * 100000 * (8 - zipcode + 1)), "House Value"
        int loanyears: UniformInteger(10, 30), "Years of the Loan"
        float loan: UniformFloat(10000, 0.85 * housevalue), "Total Loan Amount"
    end
    target loanapproval:Binary
        description: "Loan Approval"
        formula: (loan <= 20 * salary + 0.5 * commission) and (loan <= 0.7 * housevalue) and ((age < 20 and salary + 0.5 * commission >= 20000) or (age < 40 and salary + 0.5 * commission >= 25000) or (age < 60 and salary + 0.5 * commission >= 30000))
        drift changeformula
            crisis: (loan <= 10 * salary) and (loan <= 0.5 * housevalue) and ((age < 20 and salary >= 30000) or (age < 40 and salary >= 40000) or (age < 60 and salary >= 50000))
            growth: (loan <= 50 * salary + commission) and (loan <= 0.9 * housevalue) and ((age < 20 and salary + commission >= 10000) or (age < 40 and salary + commission >= 15000) or (age < 60 and salary + commission >= 20000))
        end
    end
    run seed=42
end
