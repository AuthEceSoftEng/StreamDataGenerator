DATASET LoanDatasetStreamGenerator;
DESC "A stream generator for loans, introduced in publication:\n Kalaitzidis, E., Diamantopoulos, T., Michailoudis, A., Symeonidis, A. L. (2025).\n AML4S: An AutoML Pipeline for Data Streams. Machine Learning and Knowledge Extraction 7.3, 87.\n This generator is based on the generator introduced by Agrawal et al.\n (Agrawal, R., Ghosh, S., Imielinski, T., Iyer, B., & Swami, A. N. (1992).\n An interval classifier for database mining applications. In VLDB (Vol. 92, pp. 560-573).\n Available: https://agrawal-family.com/rakesh/papers/vldb92ic.pdf.)";
PARAM seed:int, "The seed of the random generator", 42;
FEATURE salary:float, "Salary" WITH UniformFloat(20000, 60000);
FEATURE commission:float, "Commission" WITH UniformFloat(0, 0.1 * salary);
FEATURE age:int, "Age" WITH UniformInteger(20, 80);
FEATURE educationlevel:int, "Education Level" WITH UniformInteger(0, 4);
FEATURE zipcode:int, "Zip Code of the Town" WITH UniformInteger(0, 8);
FEATURE housevalue:float, "House Value" WITH UniformFloat(100000 * (8 - zipcode + 1), 2 * 100000 * (8 - zipcode + 1));
FEATURE loanyears:int, "Years of the Loan" WITH UniformInteger(10, 30);
FEATURE loan:float, "Total Loan Amount" WITH UniformFloat(10000, 0.85 * housevalue);
TARGET loanapproval:binary, "Loan Approval" WITH (loan <= 20 * salary + 0.5 * commission) and (loan <= 0.7 * housevalue) and ((age < 20 and salary + 0.5 * commission >= 20000) or (age < 40 and salary + 0.5 * commission >= 25000) or (age < 60 and salary + 0.5 * commission >= 30000));
DRIFT crisis:changeformula ON salary WITH UniformFloat(10000, 40000);
DRIFT growth:changeformula ON salary WITH UniformFloat(30000, 80000);
DRIFT crisis:changeformula ON loanapproval WITH (loan <= 10 * salary) and (loan <= 0.5 * housevalue) and ((age < 20 and salary >= 30000) or (age < 40 and salary >= 40000) or (age < 60 and salary >= 50000));
DRIFT growth:changeformula ON loanapproval WITH (loan <= 50 * salary + commission) and (loan <= 0.9 * housevalue) and ((age < 20 and salary + commission >= 10000) or (age < 40 and salary + commission >= 15000) or (age < 60 and salary + commission >= 20000));
