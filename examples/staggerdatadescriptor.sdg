dataset StaggerDataGenerator
    description: "Stream generator producing three boolean features describing objects:\n size, shape and colour. Dataset originally introduced in:\n Schlimmer, J. C., & Granger, R. H. (1986). Incremental learning from.\n noisy data. Machine learning, 1(3), 317-354."
    parameters
        seed: "The seed of the random generator"
    end
    features
        size: UniformCategorical("small", "medium", "large"), "The size of the object, one of small, medium, large"
        shape: UniformCategorical("circle", "square", "triangle"), "The shape of the object, one of circle, square, triangle"
        color: UniformCategorical("red", "blue", "green"), "The color of the object, one of red, blue, green"
    end
    target y:Binary
        description: "The target variable defined as a function of the features"
        formula: size == "small" and color == "red"
        drift changeformula
            value: color == "green" or shape == "circle"
            value: size == "medium" or size == "large"
        end
    end
    run seed=42
end
