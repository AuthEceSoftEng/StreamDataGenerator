dataset Agrawal0DataGenerator
    description: "Stream generator introduced by Agrawal et al.\n\n Relevant paper:\n Agrawal, R., Ghosh, S., Imielinski, T., Iyer, B., & Swami, A. N. (1992).\n An interval classifier for database mining applications. In VLDB (Vol. 92, pp. 560-573).\n Available online: https://agrawal-family.com/rakesh/papers/vldb92ic.pdf"
    parameters
        seed: "The seed of the random generator"
    end_parameters
    features
        float salary: UniformFloat(20000, 150000), "Annual salary (uniformly sampled between 20,000 and 150,000)."
        float commission: 0 if salary < 75000 else UniformFloat(10000, 75000), "Commission income in USD: zero for salaries below 75,000; for higher salaries a uniform random value between 10,000 and 75,000."
        int age: UniformInteger(20, 80), "Age of the individual in years (uniform integer between 20 and 80)."
        int educationlevel: UniformInteger(0, 4), "Education level code (integer 0–4) representing ascending educational attainment."
        int car: UniformInteger(1, 20), "Car manufacturer ID (integer between 1 and 20), representing the maker of the individual's vehicle."
        int zipcode: UniformInteger(0, 8), "Zip code region index of the individual's town (integer 0–8), used to influence house values."
        float housevalue: UniformFloat(50000 * zipcode, 100000 * zipcode), "Estimated house value in USD, proportional to zipcode; uniformly sampled between 50,000 * zipcode and 100,000 * zipcode."
        int houseyears: UniformInteger(1, 30), "Number of years the house has been owned (uniform integer between 1 and 30)."
        float loan: UniformFloat(0, 500000), "Total outstanding loan amount (uniformly sampled between 0 and 500,000)."
    end_features
    target loanapproval: Binary
        description: "Loan Approval (classification function 0 of the original paper is used)"
        formula: age < 40 or 60 <= age
    end_target
    drifts
        drift on loanapproval
            type: sudden,
            scenarios
                (age < 40 and 50000 <= salary and salary <= 100000) or (age < 60 and 75000 <= salary and salary <= 125000) or (25000 <= salary and salary <= 75000)
            end_scenarios
        end_drift
    end_drifts
end_dataset