DATASET Agrawal0DataGenerator;
DESC "Stream generator introduced by Agrawal et al.\n\n Relevant paper:\n Agrawal, R., Ghosh, S., Imielinski, T., Iyer, B., & Swami, A. N. (1992).\n An interval classifier for database mining applications. In VLDB (Vol. 92, pp. 560-573).\n Available online: https://agrawal-family.com/rakesh/papers/vldb92ic.pdf";
PARAM seed:int, "The seed of the random generator", 42;
FEATURE salary:float, "Salary" WITH UniformFloat(20000, 150000);
FEATURE commission:float, "Commission" WITH 0 if salary < 75000 else UniformFloat(10000, 75000);
FEATURE age:int, "Age" WITH UniformInteger(20, 80);
FEATURE educationlevel:int, "Education Level" WITH UniformInteger(0, 4);
FEATURE car:int, "Car Maker" WITH UniformInteger(1, 20);
FEATURE zipcode:int, "Zip Code of the Town" WITH UniformInteger(0, 8);
FEATURE housevalue:float, "House Value" WITH UniformFloat(50000 * zipcode, 100000 * zipcode);
FEATURE houseyears:int, "Years House Owned" WITH UniformInteger(1, 30);
FEATURE loan:float, "Total Loan Amount" WITH UniformFloat(0, 500000);
TARGET loanapproval:binary, "Loan Approval (classification function 0 of the original paper is used)" WITH age < 40 or 60 <= age;
DRIFT default:changeformula ON loanapproval WITH age < 40 or 60 <= age;
DRIFT alternative:changeformula ON loanapproval WITH (age < 40 and 50000 <= salary and salary <= 100000) or (age < 60 and 75000 <= salary and salary <= 125000) or (25000 <= salary and salary <= 75000);
