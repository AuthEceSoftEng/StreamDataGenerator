import random
import itertools
import math

class {{ name }}:
    """
    {{ description }}

    Features:
    {%- for feature in features %}
    - {{ feature.name }}: {{ feature.description }}
    {%- endfor %}

    Target:
    - {{ target.name }}: {{ target.description }}
    """
    def __init__(self, {{ parameters|join(', ', attribute='name') }}):
        """
        Initializes this random data generator

        {%- for param in parameters %}
        :param {{ param.name }}: {{ param.description }}
        {%- endfor %}
        """
        {%- for param in parameters %}
        self.{{ param.name }} = {{ param.name }}
        {%- endfor %}
        self._rng = random.Random(self.seed)
        self._instance_count = 0

        {%- if has_drift %}
        # Drift configurations by variable
        self._drift_configs = {
        {%- for drift in drifts %}
            "{{ drift.variable }}": {{ drift.drifts | tojson }},
        {%- endfor %}
        }

        # Drift runtime state per variable
        self._drift_state = {
        {%- for drift in drifts %}
            "{{ drift.variable }}": {
                "active_drift_idx": None,
                "transition_progress": 0
            },
        {%- endfor %}
        }
        {%- endif %}

        self.dataset_name = "{{ name }}"
        self.feature_names = [{{ features|map(attribute='name')|quote_list|join(', ') }}]
        self.target_name = "{{ target.name }}"

    {%- if has_drift %}
    def _check_and_update_drifts(self):
        """Trigger start/end of drifts based on instance counter."""
        for var_name, drifts in self._drift_configs.items():
            state = self._drift_state[var_name]

            # Check all drifts in order; later drifts can override earlier ones
            for idx, cfg in enumerate(drifts):
                trigger = cfg.get("trigger_point") or 0
                duration = cfg.get("duration")
                
                # Check if this drift should start
                if self._instance_count == trigger:
                    state["active_drift_idx"] = idx
                    state["transition_progress"] = 0
                
                # Check if recurring drift should end (revert to previous state)
                if (state["active_drift_idx"] == idx and 
                    duration is not None and
                    self._instance_count >= trigger + duration):
                    # Find the most recent drift that should still be active
                    state["active_drift_idx"] = None
                    for prev_idx in range(idx - 1, -1, -1):
                        prev_cfg = drifts[prev_idx]
                        prev_trigger = prev_cfg.get("trigger_point") or 0
                        prev_duration = prev_cfg.get("duration")
                        # Check if previous drift is still active
                        if prev_trigger <= self._instance_count:
                            if prev_duration is None or self._instance_count < prev_trigger + prev_duration:
                                state["active_drift_idx"] = prev_idx
                                state["transition_progress"] = 0
                                break

    def _current_formula(self, var_name, original_formula):
        """
        Resolve current formula considering active drift type.
        - sudden: immediately switch to new_formula
        - gradual: switch after transition_steps
        - incremental: same as sudden (custom interpolation left to generator logic if needed)
        - recurring: same as sudden, but ends after duration
        """
        state = self._drift_state.get(var_name)
        if not state or state["active_drift_idx"] is None:
            return original_formula

        cfg = self._drift_configs[var_name][state["active_drift_idx"]]
        drift_type = cfg.get("type")
        new_formula = cfg.get("formula")

        if drift_type in ("sudden", "recurring", "incremental"):
            return new_formula

        if drift_type == "gradual":
            steps = max(1, int(cfg.get("transition_steps") or 1))
            progress = min(state["transition_progress"] / steps, 1.0)
            state["transition_progress"] += 1
            return new_formula if progress >= 1.0 else original_formula

        return original_formula
    {%- endif %}

    def __iter__(self):
        """
        Generates and returns new data instances.

        :returns: A generator of tuples (X, y): X is feature list, y is target.
        """
        while True:
            {%- if has_drift %}
            self._check_and_update_drifts()
            {%- endif %}

            {%- for feature in features %}
            {%- if has_drift %}
            _{{ feature.name }}_expr = self._current_formula("{{ feature.name }}", "{{ feature.formula }}")
            {{ feature.name }} = eval(_{{ feature.name }}_expr)
            {%- else %}
            {{ feature.name }} = {{ feature.formula }}
            {%- endif %}
            {%- endfor %}

            {%- if has_drift %}
            _{{ target.name }}_expr = self._current_formula("{{ target.name }}", "{{ target.formula }}")
            {%- if target.classtype == 'Binary' %}
            {{ target.name }} = 1 if eval(_{{ target.name }}_expr) else 0
            {%- else %}
            {{ target.name }} = eval(_{{ target.name }}_expr)
            {%- endif %}
            {%- else %}
            {%- if target.classtype == 'Binary' %}
            {{ target.name }} = 1 if ({{ target.formula }}) else 0
            {%- else %}
            {{ target.name }} = {{ target.formula }}
            {%- endif %}
            {%- endif %}

            self._instance_count += 1
            yield [{{ features|map(attribute='name')|join(', ') }}], {{ target.name }}

    def get_n_instances(self, numinstances):
        """
        Generates and returns the number of data instances that is given as a parameter.
        """
        return itertools.islice(self, numinstances)

