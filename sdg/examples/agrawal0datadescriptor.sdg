dataset Agrawal0DataGenerator {
    description: "Stream generator introduced by Agrawal et al.\n\n Relevant paper:\n Agrawal, R., Ghosh, S., Imielinski, T., Iyer, B., & Swami, A. N. (1992).\n An interval classifier for database mining applications. In VLDB (Vol. 92, pp. 560-573).\n Available online: https://agrawal-family.com/rakesh/papers/vldb92ic.pdf"
    parameters {
        seed: "The seed of the random generator"
    }
    features {
        salary: "Salary" = UniformFloat(20000, 150000)
        commission: "Commission" = 0 if salary < 75000 else UniformFloat(10000, 75000)
        age: "Age" = UniformInteger(20, 80)
        educationlevel: "Education Level" = UniformInteger(0, 4)
        car: "Car Maker" = UniformInteger(1, 20)
        zipcode: "Zip Code of the Town" = UniformInteger(0, 8)
        housevalue: "House Value" = UniformFloat(50000 * zipcode, 100000 * zipcode)
        houseyears: "Years House Owned" = UniformInteger(1, 30)
        loan: "Total Loan Amount" = UniformFloat(0, 500000)
    }
    target loanapproval: "Loan Approval (classification function 0 of the original paper is used)" {
        type: Binary
        formula: age < 40 or 60 <= age
        drift changeformula {
            value: age < 40 or 60 <= age
            value: (age < 40 and 50000 <= salary and salary <= 100000) or (age < 60 and 75000 <= salary and salary <= 125000) or (25000 <= salary and salary <= 75000)
        }
    }
    run seed=42
}
