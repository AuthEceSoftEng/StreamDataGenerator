dataset FriedmanDataGenerator
    description: "Stream generator introduced by Friedman\n\n Relevant paper:\n Friedman, Jerome H. Multivariate Adaptive Regression Splines. The Annals of Statistics 19.1 (1991): 1-141.\n Available online: http://www.stat.yale.edu/~lc436/08Spring665/Mars_Friedman_91.pdf"
    parameters
        seed: "The seed of the random generator"
    end
    features
        x1: UniformFloat(0, 1), "The first variable"
        x2: UniformFloat(0, 1), "The second variable"
        x3: UniformFloat(0, 1), "The third variable"
        x4: UniformFloat(0, 1), "The fourth variable"
        x5: UniformFloat(0, 1), "The fifth variable"
        x6: UniformFloat(0, 1), "The sixth variable"
        x7: UniformFloat(0, 1), "The seventh variable"
        x8: UniformFloat(0, 1), "The eighth variable"
        x9: UniformFloat(0, 1), "The ninth variable"
        x10: UniformFloat(0, 1), "The tenth variable"
        noise: Gaussian(0, 1), "Noise of the target"
    end
    target y:Scalar
        description: "The target variable defined as a function of the features"
        formula: 10 * math.sin(math.pi * x1 * x2) + 20 * (x3 - 0.5) ** 2 + 10 * x4 + 5 * x5 + noise
    end
    run seed=42
end
