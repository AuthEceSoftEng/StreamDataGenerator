dataset StaggerDataGenerator {
    description: "Stream generator producing three boolean features describing objects:\n size, shape and colour. Dataset originally introduced in:\n Schlimmer, J. C., & Granger, R. H. (1986). Incremental learning from.\n noisy data. Machine learning, 1(3), 317-354."
    parameters {
        seed: "The seed of the random generator"
    }
    features {
        size: "The size of the object, one of small, medium, large" = UniformCategorical("small", "medium", "large")
        shape: "The shape of the object, one of circle, square, triangle" = UniformCategorical("circle", "square", "triangle")
        color: "The color of the object, one of red, blue, green" = UniformCategorical("red", "blue", "green")
    }
    target y: "The target variable defined as a function of the features" {
        type: Binary
        formula: size == "small" and color == "red"
        drift changeformula {
            value: color == "green" or shape == "circle"
            value: size == "medium" or size == "large"
        }
    }
    run seed=42
}
