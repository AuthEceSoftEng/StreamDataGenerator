Dataset:
    'dataset' name=ID
        ('description:' description=STRING)?
        ('parameters' parameters*=Parameter 'end')?
        ('features' features*=Feature 'end')?
        'target' target=Target
        ('drifts' drifts*=Drift 'end')?
        ('run' run_config=RunConfig)?
    'end'
;

Parameter:
    name=ID ':' description=STRING
;

Feature:
    (type=FeatureType)? name=ID ':' formula=Formula 
        (',' description=STRING)?
        ('scenarios' scenarios*=Scenario 'end')?
;

Scenario:
    name=ID ':' formula=Formula
;

FeatureType:
    'int' | 'float' | 'string' | 'bool'
;

Target:
    name=ID ':' type=ID
        'description:' description=STRING
        'formula:' formula=Formula
        ('scenarios' scenarios*=Scenario 'end')?
    'end'
;

Drift:
    'drift' 'on' variable=ID 
        'points' drift_points*=DriftPoint 'end'
    'end'
;

DriftPoint:
    trigger=INT ':' drift_type=DriftType (scenario_name=ID | is_return?='return')
        ('duration:' duration=INT)?
        ('interval:' interval=INT)?
        ('transition:' transition_steps=INT)?
    'end'
;

DriftType: 
    'sudden' | 'gradual' | 'incremental' | 'recurring'
;

RunConfig:
    arguments+=Argument[',']
;

Argument:
    name=ID '=' value=Value
;

Value:
    INT | FLOAT | STRING | BOOL
;

Formula:
    // Match until a comma followed by a quote AND end of line (for features)
    // OR match everything until newline (for target/others)
    /(.+?(?=,\s*"[^"]*"\s*(\r?\n|$)))|([^\n]+)/
;
