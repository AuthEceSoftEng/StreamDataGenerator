Dataset:
    'DATASET' name=ID ';'
    ('DESC' description=STRING ';')?
    (parameters+=Parameter)?
    (features+=Feature)?
    target=Target
    (drifts+=Drift)*
;

Parameter:
    'PARAM' name=ID ':' type=FeatureType ',' description=STRING ',' default=Value ';'
;

Feature:
    'FEATURE' name=ID ':' type=FeatureType ',' description=STRING 'WITH' formula=Formula ';'
;

Target:
    'TARGET' name=ID ':' type=TargetType ',' description=STRING 'WITH' formula=Formula ';'
;

Drift:
    'DRIFT' name=ID ':' type=ID 'ON' target_name=ID 'WITH' formula=Formula ';'
;

FeatureType:
    'int' | 'float' | 'string' | 'bool'
;

TargetType:
    'binary' | 'scalar'
;

Value:
    INT | FLOAT | STRING | BOOL
;

Formula:
    // Match everything until a semicolon
    /[^;]+/
;
