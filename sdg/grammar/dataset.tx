Dataset:
    'dataset' name=ID
        ('description:' description=STRING)?
        ('parameters' parameters*=Parameter 'end')?
        ('imports' imports*=Import[','])?
        ('features' features*=Feature 'end')?
        'target' target=Target
        ('run' run_config=RunConfig)?
    'end'
;

Parameter:
    name=ID ':' description=STRING
;

Import:
    name=ID
;

Feature:
    (type=FeatureType)? name=ID ':' formula=Formula (',' description=STRING)?
    ('drift' drift=Drift)?
;

FeatureType:
    'int' | 'float' | 'string' | 'bool' | 'object'
;

Target:
    name=ID ':' type=ID
        'description:' description=STRING
        'formula:' formula=Formula
        ('drift' drift=Drift)?
    'end'
;

Drift:
    type=ID
        formulas*=DriftFormula
    'end'
;

DriftFormula:
    (type=FeatureType)? name=ID ':' value=Formula
;

RunConfig:
    arguments+=Argument[',']
;

Argument:
    name=ID '=' value=Value
;

Value:
    INT | FLOAT | STRING | BOOL
;

Formula:
    // Match until a comma followed by a quote AND end of line (for features)
    // OR match everything until newline (for target/others)
    /(.+?(?=,\s*"[^"]*"\s*(\r?\n|$)))|([^\n]+)/
;
