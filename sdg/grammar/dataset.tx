Dataset:
    'dataset' name=ID
        ('description:' description=STRING)?
        ('parameters' parameters*=Parameter 'end_parameters')?
        ('features' features*=Feature 'end_features')?
        'target' target=Target
        ('drifts' drifts*=Drift 'end_drifts')?
        ('run' run_config=RunConfig)?
    'end_dataset'
;

Parameter:
    name=ID ':' description=STRING
;

Feature:
    (type=FeatureType)? name=ID ':' formula=Formula 
        (',' description=STRING)?
;

FeatureType:
    'int' | 'float' | 'string' | 'bool'
;

Target:
    name=ID ':' type=ID
        'description:' description=STRING
        'formula:' formula=Formula
;

Drift:
    'drift' 'on' variable=ID
        ('type:' drift_types+=DriftType (',' drift_types+=DriftType)* (',')?)?
        'scenarios' scenarios+=Formula[',\n'] (',')? 'end_scenarios'
    'end_drift'
;

DriftType: 
    'sudden' | 'gradual' | 'incremental' | 'recurring'
;

RunConfig:
    arguments+=Argument[',']
;

Argument:
    name=ID '=' value=Value
;

Value:
    INT | FLOAT | STRING | BOOL
;

Formula:
    // Match text until:
    // - a comma followed by optional whitespace and a quote (for features)
    // - end of line (for target formulas)
   /[^\n]+?(?=,\s*")|[^\n]+?(?=\n)/
;
